    {
     "command": "parameters.add",
     "params": {
      "name": "L",
      "expression": "80 mm"
     }
    },
    {
     "command": "parameters.add",
     "params": {
      "name": "W",
      "expression": "50 mm"
     }
    },
    {
     "command": "parameters.add",
     "params": {
      "name": "T",
      "expression": "6 mm"
     }
    },
    {
