    {
     "command": "sketch.create",
     "params": {
      "plane": "XY",
      "name": "PlateSketch"
     }
    },
    {
     "command": "sketch.draw.dimensioned",
     "params": {
      "command": "sketch.rectangle.center",
      "params": {
       "center": [
        0,
        0
       ],
       "corner": [
        40,
        25
       ]
      },
      "dimensions": {
       "width": "L",
       "height": "W"
      }
     }
    },
    {
     "command": "sketch.finish",
     "params": {}
    },
    {
     "command": "solid.extrude",
     "params": {
      "distance": "T",
      "name": "Plate"
     }
    },
    {
     "command": "solid.fillet",
     "params": {
      "edges": [
       [
        40,
        25,
        3
       ],
       [
        -40,
        25,
        3
       ],
       [
        40,
        -25,
        3
       ],
       [
        -40,
        -25,
        3
       ]
      ],
      "radius": 6,
      "name": "Corners"
     }
    }
   ]
  }
 },
 {
  "tool": "measure",
  "args": {}
 },
 {
  "tool": "batch",
  "args": {
   "verbose": false,
   "commands": [
    {
     "command": "sketch.create",
     "params": {
      "plane": "XY",
      "offset": "T",
      "name": "BossSketch"
     }
    },
    {
     "command": "sketch.circle.center",
     "params": {
      "center": [
       0,
       0
      ],
      "radius": 12
     }
    },
    {
     "command": "sketch.dimension",
     "params": {
      "entities": [
       "c1"
      ],
      "type": "diameter",
      "value": "boss_d"
     }
    },
    {
     "command": "sketch.circle.center",
     "params": {
      "center": [
       0,
       0
      ],
      "radius": 5
     }
    },
    {
     "command": "sketch.dimension",
     "params": {
      "entities": [
       "c2"
      ],
      "type": "diameter",
      "value": "bore"
     }
    },
    {
     "command": "sketch.finish",
     "params": {}
    },
    {
     "command": "solid.extrude",
     "params": {
      "distance": "boss_h",
      "sketch": "BossSketch",
      "profiles": [
       {
        "point": [
         8.5,
         0
        ]
       }
      ],
      "operation": "join",
      "name": "Boss"
     }
    },
    {
     "command": "solid.extrude",
     "params": {
      "distance": "T + 2",
      "sketch": "BossSketch",
      "profiles": [
       {
        "point": [
         0,
         0
        ]
       }
      ],
      "direction": "negative",
      "operation": "cut",
      "name": "Bore"
     }
    }
   ]
  }
 },
 {
  "tool": "measure",
  "args": {}
 },
 {
