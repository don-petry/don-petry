      ],
      "dir1": [
       -1,
       0,
       0
      ],
      "count1": 2,
      "spacing1": "L - 2*inset",
      "dir2": [
       0,
       -1,
       0
      ],
      "count2": 2,
      "spacing2": "W - 2*inset",
      "name": "Holes"
     }
    }
   ]
  }
 },
